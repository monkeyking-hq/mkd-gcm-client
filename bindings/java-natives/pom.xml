<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.monkeyking</groupId>
    <artifactId>mkd-gcm-sdk-parent</artifactId>
    <version>0.2.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>mkd-gcm-natives</artifactId>
  <packaging>jar</packaging>
  <name>mkd-gcm native libraries</name>
  <description>
    Platform shared libraries for mkd-gcm-ffi (loaded by the Java SDK via JNA).
    The main JAR ships windows-x86_64 and linux-x86_64 under
    dev/monkeyking/gcm/native/&lt;platform&gt;/ so one dependency works on both
    developer Windows and Linux CI/runtime.
  </description>

  <properties>
    <cargo.skip>false</cargo.skip>
    <!-- Default product need: Win64 + Linux64 in one JAR for Percussion/VJ -->
    <native.hostOnly>false</native.hostOnly>
    <rust.workspace.root>${project.basedir}/../..</rust.workspace.root>
    <native.staging.dir>${project.basedir}/target/native-staging</native.staging.dir>
  </properties>

  <build>
    <plugins>
      <!--
        Stage windows-x86_64 + linux-x86_64 (scripts/stage-natives.ps1).
        -Dnative.hostOnly=true → only the build host platform (faster local loops).
        -Dcargo.skip=true → reuse already-built artifacts under target/.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>stage-natives</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>pwsh</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-NoProfile</argument>
                <argument>-File</argument>
                <argument>${project.basedir}/scripts/stage-natives.ps1</argument>
              </arguments>
              <environmentVariables>
                <NATIVE_HOST_ONLY>${native.hostOnly}</NATIVE_HOST_ONLY>
                <NATIVE_SKIP_CARGO>${cargo.skip}</NATIVE_SKIP_CARGO>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-staged-natives</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/dev/monkeyking/gcm/native</outputDirectory>
              <resources>
                <resource>
                  <directory>${native.staging.dir}</directory>
                  <filtering>false</filtering>
                  <excludes>
                    <exclude>STAGED.txt</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>verify-required-platforms</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <fail message="Missing staged windows-x86_64 native (see scripts/stage-natives.ps1)">
                  <condition>
                    <and>
                      <not>
                        <equals arg1="${native.hostOnly}" arg2="true"/>
                      </not>
                      <not>
                        <available file="${project.build.outputDirectory}/dev/monkeyking/gcm/native/windows-x86_64/mkd_gcm_ffi.dll"/>
                      </not>
                    </and>
                  </condition>
                </fail>
                <fail message="Missing staged linux-x86_64 native (need WSL+Rust, or -Dnative.hostOnly=true)">
                  <condition>
                    <and>
                      <not>
                        <equals arg1="${native.hostOnly}" arg2="true"/>
                      </not>
                      <not>
                        <available file="${project.build.outputDirectory}/dev/monkeyking/gcm/native/linux-x86_64/libmkd_gcm_ffi.so"/>
                      </not>
                    </and>
                  </condition>
                </fail>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>windows-x86_64</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>windows-x86_64</classifier>
              <includes>
                <include>dev/monkeyking/gcm/native/windows-x86_64/**</include>
                <include>dev/monkeyking/gcm/natives/**</include>
                <include>META-INF/**</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>linux-x86_64</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>linux-x86_64</classifier>
              <includes>
                <include>dev/monkeyking/gcm/native/linux-x86_64/**</include>
                <include>dev/monkeyking/gcm/natives/**</include>
                <include>META-INF/**</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
            <configuration>
              <forceCreation>true</forceCreation>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <doclint>none</doclint>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- When not on Windows, run the bash stager instead of pwsh -->
    <profile>
      <id>native-stage-unix</id>
      <activation>
        <os>
          <family>unix</family>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>stage-natives</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>bash</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <argument>${project.basedir}/scripts/stage-natives.sh</argument>
                  </arguments>
                  <environmentVariables>
                    <HOST_ONLY>${native.hostOnly}</HOST_ONLY>
                    <SKIP_CARGO>${cargo.skip}</SKIP_CARGO>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
